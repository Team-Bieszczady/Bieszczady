# Port the NestJS server listens on
PORT=3000

# Frontend address allowed to call this API (CORS)
CORS_ORIGIN=http://localhost:5173

# Database connection used by Prisma.
# Must match the credentials in the root .env used by docker-compose.
# trustServerCertificate=true is required locally because the container
# uses a self-signed certificate.
DATABASE_URL="sqlserver://localhost:1433;database=bieszczady;user=bieszczady_user;password=Bieszczady!User2026;encrypt=true;trustServerCertificate=true"

# Secret used to sign JWT access tokens (dev only value below)
JWT_ACCESS_SECRET=change-me

# Set to "production" on deployed environments.
# Controls the `secure` flag on the refresh token cookie — without it the cookie
# would be sent over plain HTTP.
NODE_ENV=development

# Outgoing mail. The values below point at Mailtrap: messages are caught in a
# test inbox and never reach the recipient — fine for development.
#
# To receive the mails in a real inbox during testing, use a Gmail account:
#   1. Turn on 2-step verification: https://myaccount.google.com/security
#   2. Create an app password:      https://myaccount.google.com/apppasswords
#      Google shows the 16 characters once; paste them without the spaces.
#   3. Fill in the values below. SMTP_USER and SMTP_FROM must carry the same
#      address — Gmail refuses to send on behalf of another one.
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your.address@gmail.com
#   SMTP_PASS=abcdefghijklmnop
#   SMTP_FROM="Wirtualne Biuro <your.address@gmail.com>"
#
# The server reads this file only at startup: restart it after any change here.
# Gmail allows roughly 500 messages a day, so this is for testing only — the
# deployed app will use the foundation's own mail server.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@bieszczady.local


# Local Azurite emulator. On deployed environments this is the real Azure
# Storage connection string.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true