# Port the NestJS server listens on
PORT=3000

# Frontend address allowed to call this API (CORS)
CORS_ORIGIN=http://localhost:5173

# Database connection used by Prisma.
# Must match the credentials in the root .env used by docker-compose.
# trustServerCertificate=true is required locally because the container
# uses a self-signed certificate.
DATABASE_URL="sqlserver://localhost:1433;database=bieszczady;user=bieszczady_user;password=Bieszczady!User2026;encrypt=true;trustServerCertificate=true"

# Secret used to sign JWT access tokens (dev only value below)
JWT_ACCESS_SECRET=change-me

# Set to "production" on deployed environments.
# Controls the `secure` flag on the refresh token cookie — without it the cookie
# would be sent over plain HTTP.
NODE_ENV=development

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@bieszczady.local