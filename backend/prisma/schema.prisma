// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  email              String    @unique
  phone              String?
  passwordHash       String    @map("password_hash")
  avatar             String?   @db.NVarChar(Max)
  accountStatus      String    @default("ACTIVE") @map("account_status")
  isDirector         Boolean   @default(false) @map("is_director")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  lastLogin          DateTime? @map("last_login")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  moduleAccess        UserModuleAccess[] @relation("UserModuleAccessUser")
  grantedModuleAccess UserModuleAccess[] @relation("UserModuleAccessGrantedBy")
  ownedDocuments      Document[]         @relation("DocumentOwner")
  ownedFolders        Folder[]           @relation("FolderOwner")
  uploadedVersions    DocumentVersion[]  @relation("VersionUploader")
  documentAccesses        DocumentAccess[] @relation("DocumentAccessUser")
  documentAccessesGranted DocumentAccess[] @relation("DocumentAccessGrantedBy")



  projectMemberships ProjectMember[] @relation("ProjectMemberUser")
  ownedTasks         Task[]          @relation("TaskOwner")
  responsibleRisks   Risk[]          @relation("RiskResponsible")
  projectEvents      ProjectEvent[]  @relation("ProjectEventActor")
  notifications      Notification[]  @relation("NotificationRecipient")
  sentNotifications  Notification[]  @relation("NotificationActor")
  ownedIndicators    Indicator[]     @relation("IndicatorOwner")

  createdBudgetVersions   BudgetVersion[]      @relation("BudgetVersionCreatedBy")
  submittedBudgetVersions BudgetVersion[]      @relation("BudgetVersionSubmittedBy")
  approvedBudgetVersions  BudgetVersion[]      @relation("BudgetVersionApprovedBy")
  budgetHistory           BudgetHistoryEntry[] @relation("BudgetHistoryActor")
  enteredBudgetInvoices   BudgetInvoice[]      @relation("BudgetInvoiceEnteredBy")
  budgetAccesses          BudgetAccess[]       @relation("BudgetAccessUser")
  budgetAccessesGranted   BudgetAccess[]       @relation("BudgetAccessGrantedBy")

  @@map("users")
}

model UserModuleAccess {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  module      String
  grantedAt   DateTime @default(now()) @map("granted_at")
  grantedById String   @map("granted_by_id")

  user      User @relation("UserModuleAccessUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grantedBy User @relation("UserModuleAccessGrantedBy", fields: [grantedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, module])
  @@map("user_module_access")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String   @map("actor_id")
  targetId  String   @map("target_id")
  action    String
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model ProjectStatus {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   @default("gray")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects Project[] @relation("ProjectStatusProjects")

  @@map("project_statuses")
}

model ProjectType {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects ProjectTypesOnProjects[] @relation("ProjectTypesOnProjectsByType")

  @@map("project_types")
}

model ProjectRecipient {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects ProjectRecipientsOnProjects[] @relation("ProjectRecipientsOnProjectsByRecipient")

  @@map("project_recipients")
}

model Project {
  id             String    @id @default(uuid())
  name           String
  description    String    @db.NVarChar(Max)
  statusId       String?   @map("status_id")
  color          String    @default("green")
  budgetAmount   Decimal?  @map("budget_amount") @db.Decimal(12, 2)
  startDate      DateTime? @map("start_date") @db.Date
  plannedEndDate DateTime? @map("planned_end_date") @db.Date
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  status ProjectStatus? @relation("ProjectStatusProjects", fields: [statusId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  types      ProjectTypesOnProjects[]      @relation("ProjectTypesOnProjectsByProject")
  recipients ProjectRecipientsOnProjects[] @relation("ProjectRecipientsOnProjectsByProject")
  members    ProjectMember[]               @relation("ProjectMembers")
  goals      Goal[]                        @relation("ProjectGoals")
  stages     Stage[]                       @relation("ProjectStages")
  risks      Risk[]                        @relation("ProjectRisks")
  events     ProjectEvent[]                @relation("ProjectEvents")
  indicators Indicator[]                   @relation("ProjectIndicators")
  partners   PartnerProject[]              @relation("PartnerProjectsByProject")

  budgetVersions         BudgetVersion[]          @relation("ProjectBudgetVersions")
  budgetColumns          BudgetColumn[]           @relation("ProjectBudgetColumns")
  budgetActuals          BudgetActual[]           @relation("ProjectBudgetActuals")
  budgetCategorySettings BudgetCategorySettings[] @relation("ProjectBudgetCategorySettings")
  budgetHistory          BudgetHistoryEntry[]     @relation("ProjectBudgetHistory")
  budgetAccesses         BudgetAccess[]           @relation("ProjectBudgetAccess")

  @@index([statusId])
  @@map("projects")
}

model Partner {
  id                  String    @id @default(uuid())
  name                String
  type                String
  nip                 String    @default("")
  city                String    @default("")
  email               String    @default("")
  contactName         String    @map("contact_name")
  contactEmail        String    @map("contact_email")
  contactPhone        String    @default("") @map("contact_phone")
  agreement           String
  agreementValidUntil DateTime? @map("agreement_valid_until") @db.Date
  status              String    @default("ACTIVE")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  projects         PartnerProject[] @relation("PartnerProjectsByPartner")
  members          ProjectMember[]  @relation("PartnerMembers")
  budgetCategories BudgetCategory[] @relation("PartnerBudgetCategories")

  @@map("partners")
}

model PartnerProject {
  partnerId String @map("partner_id")
  projectId String @map("project_id")

  partner Partner @relation("PartnerProjectsByPartner", fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project Project @relation("PartnerProjectsByProject", fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([partnerId, projectId])
  @@index([projectId])
  @@map("partner_projects")
}

model ProjectTypesOnProjects {
  projectId     String @map("project_id")
  projectTypeId String @map("project_type_id")

  project     Project     @relation("ProjectTypesOnProjectsByProject", fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projectType ProjectType @relation("ProjectTypesOnProjectsByType", fields: [projectTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([projectId, projectTypeId])
  @@index([projectTypeId])
  @@map("project_types_on_projects")
}

model ProjectRecipientsOnProjects {
  projectId   String @map("project_id")
  recipientId String @map("recipient_id")

  project   Project          @relation("ProjectRecipientsOnProjectsByProject", fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipient ProjectRecipient @relation("ProjectRecipientsOnProjectsByRecipient", fields: [recipientId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([projectId, recipientId])
  @@index([recipientId])
  @@map("project_recipients_on_projects")
}

model ProjectMember {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  userId      String   @map("user_id")
  projectRole String   @map("project_role")
  partnerId   String?  @map("partner_id")
  joinedAt    DateTime @default(now()) @map("joined_at")

  project Project  @relation("ProjectMembers", fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user    User     @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partner Partner? @relation("PartnerMembers", fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  modules ProjectMemberModule[]

  @@unique([projectId, userId])
  @@index([userId])
  @@index([partnerId])
  @@map("project_members")
}

model ProjectMemberModule {
  id       String @id @default(uuid())
  memberId String @map("member_id")
  module   String

  member ProjectMember @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([memberId, module])
  @@map("project_member_modules")
}

model Goal {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  goalNumber  Int      @map("goal_number")
  title       String
  description String   @db.NVarChar(Max)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation("ProjectGoals", fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([projectId, goalNumber])
  @@index([projectId])
  @@map("goals")
}

model Stage {
  id               String    @id @default(uuid())
  projectId        String    @map("project_id")
  name             String
  description      String    @default("") @db.NVarChar(Max)
  sortOrder        Int       @map("sort_order")
  startDate        DateTime? @map("start_date") @db.Date
  deadline         DateTime  @db.Date
  originalDeadline DateTime? @map("original_deadline") @db.Date
  deadlineNote     String?   @map("deadline_note") @db.NVarChar(Max)
  completedAt      DateTime? @map("completed_at")
  archivedAt       DateTime? @map("archived_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  project    Project     @relation("ProjectStages", fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  activities Activity[]  @relation("StageActivities")
  indicators Indicator[] @relation("StageIndicators")

  @@index([projectId])
  @@map("stages")
}

model Activity {
  id        String   @id @default(uuid())
  stageId   String   @map("stage_id")
  name      String
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stage Stage  @relation("StageActivities", fields: [stageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tasks Task[] @relation("ActivityTasks")

  @@index([stageId])
  @@map("activities")
}

model Task {
  id          String    @id @default(uuid())
  activityId  String    @map("activity_id")
  ownerId     String?   @map("owner_id")
  title       String
  description String    @default("") @db.NVarChar(Max)
  status      String    @default("NEW")
  priority    String    @default("MEDIUM")
  dueDate     DateTime? @map("due_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  activity Activity  @relation("ActivityTasks", fields: [activityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  owner    User?     @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subtasks      Subtask[]      @relation("TaskSubtasks")
  notifications Notification[] @relation("TaskNotifications")
  indicators    Indicator[]    @relation("TaskIndicators")

  @@index([activityId])
  @@index([ownerId])
  @@map("tasks")
}

model Subtask {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  title     String
  done      Boolean  @default(false)
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task Task @relation("TaskSubtasks", fields: [taskId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([taskId])
  @@map("subtasks")
}

model Risk {
  id                String   @id @default(uuid())
  projectId         String   @map("project_id")
  responsibleUserId String?  @map("responsible_user_id")
  description       String   @db.NVarChar(Max)
  probability       String   @default("MEDIUM")
  impact            String   @default("MEDIUM")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  project     Project @relation("ProjectRisks", fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  responsible User?   @relation("RiskResponsible", fields: [responsibleUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([projectId])
  @@index([responsibleUserId])
  @@map("risks")
}

model Indicator {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  name         String
  description  String   @default("") @db.NVarChar(Max)
  targetValue  Int      @map("target_value")
  currentValue Int      @default(0) @map("current_value")
  scope        String
  stageId      String?  @map("stage_id")
  taskId       String?  @map("task_id")
  ownerId      String?  @map("owner_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project Project           @relation("ProjectIndicators", fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stage   Stage?            @relation("StageIndicators", fields: [stageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  task    Task?             @relation("TaskIndicators", fields: [taskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  owner   User?             @relation("IndicatorOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  folders IndicatorFolder[] @relation("IndicatorFolderIndicator")

  @@index([projectId])
  @@index([stageId])
  @@index([taskId])
  @@index([ownerId])
  @@map("indicators")
}

model IndicatorFolder {
  indicatorId String @map("indicator_id")
  folderId    String @map("folder_id")

  indicator Indicator @relation("IndicatorFolderIndicator", fields: [indicatorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  folder    Folder    @relation("IndicatorFolderFolder", fields: [folderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([indicatorId, folderId])
  @@index([folderId])
  @@map("indicator_folders")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model ProjectEvent {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  actorId   String?  @map("actor_id")
  source    String   @default("AUTOMATIC")
  content   String   @db.NVarChar(Max)
  dedupeKey String?  @unique @map("dedupe_key")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation("ProjectEvents", fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor   User?   @relation("ProjectEventActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([projectId, createdAt])
  @@index([source, createdAt])
  @@index([actorId])
  @@map("project_events")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  kind      String
  taskId    String    @map("task_id")
  actorId   String?   @map("actor_id")
  dedupeKey String?   @unique @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  task  Task  @relation("TaskNotifications", fields: [taskId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, createdAt])
  @@index([taskId])
  @@map("notifications")
}

model Folder {
  id        String    @id @default(uuid())
  projectId String    @map("project_id")
  parentId  String?   @map("parent_id")
  name      String
  ownerId   String    @map("owner_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  owner     User       @relation("FolderOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent    Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Folder[]   @relation("FolderTree")
  documents  Document[]
  accesses   DocumentAccess[]
  indicators IndicatorFolder[] @relation("IndicatorFolderFolder")

  @@index([projectId])
  @@index([parentId])
  @@map("folders")
}

model Document {
  id        String    @id @default(uuid())
  projectId String    @map("project_id")
  folderId  String    @map("folder_id")
  name      String
  kind      String
  status    String
  ownerId   String    @map("owner_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  folder   Folder            @relation(fields: [folderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  owner    User              @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versions DocumentVersion[]
  accesses DocumentAccess[]


  @@index([projectId])
  @@index([folderId])
  @@map("documents")
}

model DocumentVersion {
  id           String   @id @default(uuid())
  documentId   String   @map("document_id")
  versionNo    Int      @map("version_no")
  storageKey   String   @map("storage_key")
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  changeNote   String?  @map("change_note")
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  document   Document @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uploadedBy User     @relation("VersionUploader", fields: [uploadedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([documentId, versionNo])
  @@index([documentId])
  @@map("document_versions")
}

model DocumentAccess {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  folderId    String?  @map("folder_id")
  documentId  String?  @map("document_id")
  userId      String   @map("user_id")
  level       String
  grantedById String   @map("granted_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  folder    Folder?   @relation(fields: [folderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  document  Document? @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User      @relation("DocumentAccessUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grantedBy User      @relation("DocumentAccessGrantedBy", fields: [grantedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

@@index([folderId])
@@index([documentId])
@@index([userId])
@@map("document_access")
}

model BudgetVersion {
  id            String    @id @default(uuid())
  projectId     String    @map("project_id")
  number        Int
  name          String
  status        String
  isCurrent     Boolean   @default(false) @map("is_current")
  description   String    @default("") @db.NVarChar(Max)
  createdById   String    @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  submittedById String?   @map("submitted_by_id")
  submittedAt   DateTime? @map("submitted_at")
  approvedById  String?   @map("approved_by_id")
  approvedAt    DateTime? @map("approved_at")
  savedAt       DateTime? @map("saved_at")

  project     Project          @relation("ProjectBudgetVersions", fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy   User             @relation("BudgetVersionCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  submittedBy User?            @relation("BudgetVersionSubmittedBy", fields: [submittedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedBy  User?            @relation("BudgetVersionApprovedBy", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categories  BudgetCategory[] @relation("BudgetVersionCategories")
  positions   BudgetPosition[] @relation("BudgetVersionPositions")

  @@unique([projectId, number])
  @@index([projectId])
  @@index([createdById])
  @@index([submittedById])
  @@index([approvedById])
  @@map("budget_versions")
}

model BudgetCategory {
  id        String  @id @default(uuid())
  versionId String  @map("version_id")
  key       String
  name      String
  partnerId String? @map("partner_id")
  sortOrder Int     @map("sort_order")

  version BudgetVersion @relation("BudgetVersionCategories", fields: [versionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partner Partner?      @relation("PartnerBudgetCategories", fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([versionId, key])
  @@index([partnerId])
  @@map("budget_categories")
}

model BudgetPosition {
  id              String  @id @default(uuid())
  versionId       String  @map("version_id")
  categoryKey     String  @map("category_key")
  key             String
  name            String
  sortOrder       Int     @map("sort_order")
  planned         Decimal @default(0) @db.Decimal(12, 2)
  grant           Decimal @default(0) @db.Decimal(12, 2)
  ownContribution Decimal @default(0) @map("own_contribution") @db.Decimal(12, 2)

  version BudgetVersion @relation("BudgetVersionPositions", fields: [versionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([versionId, key])
  @@index([versionId, categoryKey])
  @@map("budget_positions")
}

model BudgetColumn {
  id        String  @id @default(uuid())
  projectId String  @map("project_id")
  key       String
  name      String
  type      String
  locked    Boolean @default(false)
  sortOrder Int     @map("sort_order")

  project Project @relation("ProjectBudgetColumns", fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([projectId, key])
  @@map("budget_columns")
}

model BudgetActual {
  id               String  @id @default(uuid())
  projectId        String  @map("project_id")
  positionKey      String  @map("position_key")
  status           String?
  documentFolderId String? @map("document_folder_id")
  documentId       String? @map("document_id")

  project  Project             @relation("ProjectBudgetActuals", fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  values   BudgetActualValue[] @relation("BudgetActualValues")
  invoices BudgetInvoice[]     @relation("BudgetActualInvoices")

  @@unique([projectId, positionKey])
  @@map("budget_actuals")
}

model BudgetActualValue {
  actualId  String @map("actual_id")
  columnKey String @map("column_key")
  value     String @db.NVarChar(Max)

  actual BudgetActual @relation("BudgetActualValues", fields: [actualId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([actualId, columnKey])
  @@map("budget_actual_values")
}

model BudgetInvoice {
  id               String   @id @default(uuid())
  actualId         String   @map("actual_id")
  number           String
  contractor       String
  date             DateTime @db.Date
  amount           Decimal  @db.Decimal(12, 2)
  grant            Decimal  @default(0) @db.Decimal(12, 2)
  ownContribution  Decimal  @default(0) @map("own_contribution") @db.Decimal(12, 2)
  status           String   @default("TO_BE_PAID")
  enteredById      String   @map("entered_by_id")
  documentFolderId String?  @map("document_folder_id")
  documentId       String?  @map("document_id")
  createdAt        DateTime @default(now()) @map("created_at")

  actual    BudgetActual @relation("BudgetActualInvoices", fields: [actualId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enteredBy User         @relation("BudgetInvoiceEnteredBy", fields: [enteredById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([actualId])
  @@index([enteredById])
  @@map("budget_invoices")
}

model BudgetCategorySettings {
  id               String  @id @default(uuid())
  projectId        String  @map("project_id")
  categoryKey      String  @map("category_key")
  detailed         Boolean @default(true)
  partnerCanEdit   Boolean @default(false) @map("partner_can_edit")
  visibleToPartner Boolean @default(false) @map("visible_to_partner")
  documentFolderId String? @map("document_folder_id")
  documentId       String? @map("document_id")

  project Project @relation("ProjectBudgetCategorySettings", fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([projectId, categoryKey])
  @@map("budget_category_settings")
}

model BudgetHistoryEntry {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  versionId   String?  @map("version_id")
  versionName String   @map("version_name")
  kind        String
  comment     String?  @db.NVarChar(Max)
  actorId     String   @map("actor_id")
  at          DateTime @default(now())

  project Project @relation("ProjectBudgetHistory", fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor   User    @relation("BudgetHistoryActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([projectId])
  @@index([actorId])
  @@map("budget_history")
}

model BudgetAccess {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  userId      String   @map("user_id")
  grantedById String   @map("granted_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  project   Project @relation("ProjectBudgetAccess", fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User    @relation("BudgetAccessUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grantedBy User    @relation("BudgetAccessGrantedBy", fields: [grantedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([grantedById])
  @@map("budget_access")
}
