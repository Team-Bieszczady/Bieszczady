# SA (superuser) password for the local SQL Server container.
# SQL Server enforces a strong password: at least 8 characters containing
# upper case, lower case, digits and a symbol. A weak value makes the
# container fail to start. Placeholder only, safe because this container
# is local and throwaway.
DB_SA_PASSWORD=Bieszczady!2026

# Application database and login, created by docker/init/01-init.sql
DB_NAME=bieszczady
DB_USER=bieszczady_user
DB_PASSWORD=Bieszczady!User2026

# Host port the database is exposed on (SQL Server uses 1433)
DB_PORT=1433
